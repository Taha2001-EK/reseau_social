<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50 antialiased">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Mini Réseau Social{% endblock %}</title>
        
        {# --- POLICE (Inter) --- #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        
        {# --- TAILWIND CSS (CDN) --- #}
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Inter', 'sans-serif'],
                        },
                        colors: {
                            primary: {
                                50: '#eff6ff',
                                100: '#dbeafe',
                                200: '#bfdbfe',
                                300: '#93c5fd',
                                400: '#60a5fa',
                                500: '#3b82f6',
                                600: '#2563eb',
                                700: '#1d4ed8',
                                800: '#1e40af',
                                900: '#1e3a8a',
                            }
                        }
                    }
                }
            }
        </script>
        <style>
            /* Custom Scrollbar for a premium feel */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #f1f5f9; 
            }
            ::-webkit-scrollbar-thumb {
                background: #cbd5e1; 
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8; 
            }
        </style>
    </head>
    <body class="flex flex-col min-h-full">
        
        {# --- NAVIGATION --- #}
        <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center">
                        <a href="{{ path('app_home') }}" class="flex-shrink-0 flex items-center gap-2 group">
                            <div class="w-8 h-8 bg-gradient-to-br from-primary-500 to-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-lg group-hover:scale-105 transition-transform duration-200">
                                S
                            </div>
                            <span class="font-bold text-xl text-slate-900 tracking-tight">Social<span class="text-primary-600">Net</span></span>
                        </a>
                    </div>
                    
                    <div class="flex items-center gap-4">
                        {% if app.user %}
                            <div class="hidden md:flex items-center gap-2 text-sm text-slate-600 mr-2">
                                <span>Bonjour,</span>
                                <span class="font-semibold text-slate-900">{{ app.user.username }}</span>
                            </div>
                            
                            <a href="{{ path('post_create') }}" class="hidden sm:inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors duration-200">
                                <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                                Publier
                            </a>
                            
                            <a href="{{ path('user_profile', {id: app.user.id}) }}" class="p-2 text-slate-400 hover:text-primary-600 transition-colors duration-200" title="Mon Profil">
                                <span class="sr-only">Profil</span>
                                <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                </div>
                            </a>
                            
                            <a href="{{ path('app_logout') }}" class="p-2 text-slate-400 hover:text-red-600 transition-colors duration-200" title="Déconnexion">
                                <span class="sr-only">Déconnexion</span>
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors duration-200">Connexion</a>
                            <a href="{{ path('app_register') }}" class="inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-full text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all duration-200">Inscription</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>

        {# --- FLASH MESSAGES --- #}
        <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-xl p-4 flex items-start gap-3 shadow-sm
                        {{ label == 'error' ? 'bg-red-50 text-red-700 border border-red-100' : 'bg-green-50 text-green-700 border border-green-100' }}">
                        <div class="flex-shrink-0">
                            {% if label == 'error' %}
                                <svg class="h-5 w-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            {% else %}
                                <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            {% endif %}
                        </div>
                        <div class="text-sm font-medium">{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# --- MAIN CONTENT --- #}
        <main class="flex-grow">
            {% block body %}{% endblock %}
        </main>

        {# --- FOOTER --- #}
        <footer class="bg-white border-t border-slate-200 mt-auto py-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <p class="text-center text-sm text-slate-400">
                    &copy; {{ 'now'|date('Y') }} Mini Réseau Social. Design with Tailwind CSS.
                </p>
            </div>
        </footer>

    </body>
</html>