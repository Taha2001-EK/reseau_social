<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Mini Réseau Social{% endblock %}</title>
        {# On charge Bootstrap pour le style #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        
        {# --- MENU DE NAVIGATION --- #}
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">My Social Network</a>
                <div class="navbar-nav ms-auto d-flex flex-row align-items-center gap-3">
                    {% if app.user %}
                        <span class="text-light">Bonjour <strong>{{ app.user.username }}</strong></span>
                        <a href="{{ path('user_profile', {id: app.user.id}) }}" class="btn btn-outline-light btn-sm">Mon Profil</a>
                        <a href="{{ path('post_create') }}" class="btn btn-primary btn-sm">Publier</a>
                        <a href="{{ path('app_logout') }}" class="text-danger text-decoration-none">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="nav-link">Connexion</a>
                        <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-sm">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        {# --- MESSAGES FLASH (Succès/Erreur) --- #}
        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# --- CONTENU DES PAGES --- #}
        {% block body %}{% endblock %}

    </body>
</html>