{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 800px; margin: 30px auto;">
    <div class="card p-4 mb-4">
        <h1>Profil de {{ user.username }}</h1>
        <p><strong>Email :</strong> {{ user.email }}</p>
        <p><strong>Membre depuis l'ID :</strong> <span class="badge bg-secondary">{{ user.id }}</span></p>
    </div>

    <h2 class="mt-4">Ses publications ({{ posts|length }})</h2>
    
    {% for post in posts %}
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h5 card-title">
                    <a href="{{ path('post_show', {'id': post.id}) }}" class="text-decoration-none">{{ post.title }}</a>
                </h3>
                <h6 class="card-subtitle mb-2 text-muted">{{ post.createdAt|date('d/m/Y H:i') }}</h6>
                <p class="card-text">{{ post.content|slice(0, 100) }}...</p>
            </div>
        </div>
    {% else %}
        <p>Cet utilisateur n'a encore rien publié.</p>
    {% endfor %}
    
    <div class="mt-3">
        <a href="{{ path('app_home') }}">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}