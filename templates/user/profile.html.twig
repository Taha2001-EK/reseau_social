{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    {# --- INFO PROFIL --- #}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-8 flex items-center gap-6">
        <div class="h-20 w-20 rounded-full bg-gradient-to-br from-primary-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shadow-md">
            {{ user.username|first|upper }}
        </div>
        <div>
            <h1 class="text-2xl font-bold text-slate-900 mb-1">{{ user.username }}</h1>
            <p class="text-slate-500 flex items-center gap-2 text-sm">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                {{ user.email }}
            </p>
            <div class="mt-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                Membre #{{ user.id }}
            </div>
        </div>
    </div>

    <div class="border-b border-slate-200 pb-2 mb-6 flex justify-between items-end">
        <h2 class="text-xl font-bold text-slate-900">Ses publications</h2>
        <span class="text-sm text-slate-500 bg-slate-50 px-2 py-1 rounded-full">{{ posts|length }} posts</span>
    </div>
    
    <div class="space-y-4">
        {% for post in posts %}
            <article class="bg-white rounded-lg shadow-sm border border-slate-200 p-5 hover:border-primary-300 transition-colors duration-200">
                 <div class="flex justify-between items-start">
                    <h3 class="text-lg font-semibold text-slate-900 mb-1">
                        <a href="{{ path('post_show', {'id': post.id}) }}" class="hover:text-primary-600 transition-colors">
                            {{ post.title }}
                        </a>
                    </h3>
                    <span class="text-xs text-slate-400 whitespace-nowrap">{{ post.createdAt|date('d/m/Y') }}</span>
                </div>
                <p class="text-slate-600 text-sm line-clamp-2 leading-relaxed">
                    {{ post.content }}
                </p>
                <div class="mt-3 pt-3 border-t border-slate-50 flex justify-end">
                     <a href="{{ path('post_show', {'id': post.id}) }}" class="text-xs font-medium text-primary-600 hover:text-primary-700">Lire plus →</a>
                </div>
            </article>
        {% else %}
            <div class="text-center py-12 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                <p class="text-slate-500 italic">Cet utilisateur n'a encore rien publié.</p>
            </div>
        {% endfor %}
    </div>
    
    <div class="mt-8 pt-6 border-t border-slate-200">
        <a href="{{ path('app_home') }}" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-primary-600 transition-colors">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}