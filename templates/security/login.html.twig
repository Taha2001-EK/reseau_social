{% extends 'base.html.twig' %}

{% block title %}Log in - Facebook Clone{% endblock %}

{% block body %}
<div class="container login-container" style="min-height: 80vh; display: flex; align-items: center;">
    <div class="row w-100 align-items-center justify-content-center">
        <!-- Left Side: Branding -->
        <div class="col-md-6 mb-5 mb-md-0 text-center text-md-start login-left pe-md-5">
            <h1 class="text-primary fw-bold mb-3" style="font-size: 3.5rem;">facebook</h1>
            <p class="fs-4">Connect with friends and the world around you on Facebook.</p>
        </div>

        <!-- Right Side: Login Form -->
        <div class="col-md-5 col-lg-4 offset-md-1">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4">
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger text-center" role="alert">
                                Identifiants invalides. Veuillez vérifier votre email et mot de passe.
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control form-control-lg fs-6" placeholder="Email address" autocomplete="email" required autofocus>
                        </div>
                        <div class="mb-3">
                            <input type="password" name="_password" id="inputPassword" class="form-control form-control-lg fs-6" placeholder="Password" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="d-grid gap-2 mb-3">
                            <button class="btn btn-primary btn-lg fw-bold fs-5" type="submit">Log In</button>
                        </div>
                        
                        <hr class="my-4">
                        
                        <div class="text-center">
                             <a href="{{ path('app_register') }}" class="btn btn-success btn-lg fw-bold fs-6 px-4">Create new account</a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-3 small">
                <p><strong>Create a Page</strong> for a celebrity, brand or business.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
