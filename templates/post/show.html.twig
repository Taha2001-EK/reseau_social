{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="mb-6">
        <a href="{{ path('app_home') }}" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors">
            <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Retour au fil d'actualité
        </a>
    </div>

    {# --- LE POST --- #}
    <article class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-8">
        <div class="p-6 sm:p-8">
            <h1 class="text-3xl font-bold text-slate-900 mb-4">{{ post.title }}</h1>
            
            <div class="flex items-center gap-3 mb-6 pb-6 border-b border-slate-100">
                <div class="h-10 w-10 rounded-full bg-gradient-to-br from-primary-100 to-indigo-100 flex items-center justify-center text-primary-600 font-bold">
                    {{ post.author ? post.author.username|first|upper : 'A' }}
                </div>
                <div>
                    <div class="font-semibold text-slate-900">
                        <a href="{{ path('user_profile', {id: post.author.id}) }}" class="hover:text-primary-600 transition-colors">
                            {{ post.author.username }}
                        </a>
                    </div>
                    <div class="text-xs text-slate-500">
                        Publié le {{ post.createdAt|date('d/m/Y à H:i') }}
                    </div>
                </div>
            </div>

            <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed mb-6">
                {{ post.content|nl2br }}
            </div>

            {# Boutons (Visible seulement pour l'auteur) #}
            {% if app.user and app.user == post.author %}
                <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                    <a href="{{ path('post_edit', {'id': post.id}) }}" class="inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-xs font-medium rounded-full text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors">
                        <svg class="-ml-0.5 mr-2 h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        Modifier
                    </a>
                    
                    <form method="post" action="{{ path('post_delete', {'id': post.id}) }}" class="inline-block" onsubmit="return confirm('Voulez-vous vraiment supprimer ce post ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                        <input type="hidden" name="_method" value="DELETE">
                        <button class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-xs font-medium rounded-full text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
                            <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            Supprimer
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </article>

    {# --- LES COMMENTAIRES --- #}
    <section class="bg-slate-50 rounded-xl p-6 sm:p-8 border border-slate-200">
        <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
            <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            Commentaires ({{ post.comments|length }})
        </h3>

        {# Formulaire d'ajout #}
        {% if app.user %}
            <form action="{{ path('comment_create', {'postId': post.id}) }}" method="post" class="mb-8 relative">
                <div class="overflow-hidden rounded-lg shadow-sm ring-1 ring-inset ring-slate-300 focus-within:ring-2 focus-within:ring-primary-600">
                    <label for="comment" class="sr-only">Votre commentaire</label>
                    <textarea rows="3" name="content" id="comment" class="block w-full resize-none border-0 bg-transparent py-1.5 text-slate-900 placeholder:text-slate-400 focus:ring-0 sm:text-sm sm:leading-6 px-3" placeholder="Écrire un commentaire..." required></textarea>

                    {# Spacer for button area #}
                    <div class="py-2" aria-hidden="true">
                        <div class="py-px">
                            <div class="h-9"></div>
                        </div>
                    </div>
                </div>

                <div class="absolute inset-x-0 bottom-0 flex justify-end py-2 pl-3 pr-2">
                    <button type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 transition-colors">Envoyer</button>
                </div>
            </form>
        {% else %}
            <div class="bg-indigo-50 border border-indigo-100 rounded-lg p-4 mb-8 text-center">
                <p class="text-sm text-indigo-700">
                    <a href="{{ path('app_login') }}" class="font-medium underline hover:text-indigo-600">Connectez-vous</a> pour participer à la discussion.
                </p>
            </div>
        {% endif %}

        {# Liste #}
        <div class="space-y-6">
            {% for comment in post.comments %}
                <div class="flex space-x-3">
                    <div class="flex-shrink-0">
                        <div class="h-8 w-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 text-xs font-bold">
                            {{ comment.author.username|first|upper }}
                        </div>
                    </div>
                    <div class="flex-1">
                        <div class="text-sm mb-1">
                            <span class="font-medium text-slate-900">{{ comment.author.username }}</span>
                            <span class="text-slate-500 ml-1">{{ comment.createdAt|date('d/m/Y à H:i') }}</span>
                        </div>
                        <div class="text-sm text-slate-700">
                            <p>{{ comment.content }}</p>
                        </div>
                        
                        {# Suppression commentaire #}
                        {% if app.user and app.user == comment.author %}
                            <div class="mt-1">
                                <form method="post" action="{{ path('comment_delete', {'id': comment.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-comment' ~ comment.id) }}">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium">Supprimer</button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p class="text-center text-slate-500 text-sm italic">Soyez le premier à commenter !</p>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}